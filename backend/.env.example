
# Copy this file to ".env" and fill in the real values. NEVER commit ".env" to GitHub.

# Where the API listens (hosting platforms set PORT for you)
PORT=3000
# Use "development" on your computer and "production" on the live server
NODE_ENV=development

# Website address(es) allowed to call the API, separated by commas, no trailing slash.
# Local testing with Live Server:  http://127.0.0.1:5500,http://localhost:5500
# Live site:                       https://www.yourdomain.co.ke
ALLOWED_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Who receives the quote forms. TESTING with Mailgun's sandbox: use your own email,
# and add it under "Authorized Recipients" in Mailgun first.
# LIVE: change this to jia@jazapay.co.ke (or whatever the final address is).
RECIPIENT_EMAIL=your-own-email@example.com

# Mailgun SMTP details (Mailgun dashboard > Sending > Domain settings > SMTP credentials)
# If your Mailgun account is in the EU region, use smtp.eu.mailgun.org instead.
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=postmaster@sandboxXXXXXXXXXXXXXXXX.mailgun.org
EMAIL_PASS=your-mailgun-smtp-password
# The "from" address. For the sandbox, use the same address as EMAIL_USER.
EMAIL_FROM=postmaster@sandboxXXXXXXXXXXXXXXXX.mailgun.org
